APP_NAME=IBVAP
APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ibvap

CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# Phase 2: Video Intelligence
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.40
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=auto

LOW_LIGHT_BRIGHTNESS_THRESHOLD=50.0
VERY_DARK_BRIGHTNESS_THRESHOLD=20.0
LOW_CONTRAST_THRESHOLD=30.0
BLUR_THRESHOLD=100.0

# Phase 3: Object Tracking
TRACKER_MAX_AGE=30
TRACKER_MIN_HITS=3
HISTORY_MAX_LENGTH=50
MOVEMENT_STATIONARY_THRESHOLD=2.0

# Phase 4: Security Rule Engine
ALERT_COOLDOWN_SECONDS=60
NIGHT_START_TIME=18:00
NIGHT_END_TIME=06:00
LOITERING_THRESHOLD_SECONDS=60
CROWD_MIN_PEOPLE=5

# Phase 5: Event Storage & Evidence
EVIDENCE_DIR=../data/evidence
